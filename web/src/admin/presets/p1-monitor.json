{
  "id": "p1-monitor",
  "name": "P1 Monitor",
  "description": "Power and gas from a P1 Monitor (ztatz) on your smart meter",
  "category": "energy",
  "icon": "bolt",
  "tags": ["local", "no-key", "nl"],
  "docs": "https://github.com/klaasnicolaas/python-p1monitor",
  "comment": "The official API page of ztatz.nl was not reachable; the endpoint and field names are those of the python-p1monitor library and its fixture, which Home Assistant uses. The answer is a list with the newest reading first, hence $[0]. The key TIMESTAMP_lOCAL really has a lower-case L.",
  "placeholders": [
    {
      "key": "ip",
      "label": "IP address of the P1 Monitor",
      "kind": "host",
      "example": "192.168.1.61"
    }
  ],
  "source": {
    "name": "P1 Monitor",
    "url": "http://{ip}/api/v1/smartmeter?limit=1&json=object",
    "method": "GET",
    "body": "",
    "auth": { "kind": "none", "name": "" },
    "headers": [],
    "intervalSeconds": 30,
    "sample": [
      {
        "CONSUMPTION_GAS_M3": 2289.967,
        "CONSUMPTION_KWH_HIGH": 2996.141,
        "CONSUMPTION_KWH_LOW": 5436.256,
        "CONSUMPTION_W": 935,
        "PRODUCTION_KWH_HIGH": 4408.947,
        "PRODUCTION_KWH_LOW": 1575.502,
        "PRODUCTION_W": 0,
        "TARIFCODE": "D",
        "TIMESTAMP_UTC": 1633130812,
        "TIMESTAMP_lOCAL": "2021-10-02 01:26:52"
      }
    ]
  },
  "values": [
    { "name": "Power used", "path": "$[0].CONSUMPTION_W", "unit": "W", "decimals": 0 },
    { "name": "Power returned", "path": "$[0].PRODUCTION_W", "unit": "W", "decimals": 0 },
    { "name": "Gas", "path": "$[0].CONSUMPTION_GAS_M3", "unit": "m³", "decimals": 3 },
    { "name": "Tariff", "path": "$[0].TARIFCODE" }
  ],
  "lists": []
}
