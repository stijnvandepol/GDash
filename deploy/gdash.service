# systemd unit for GDash on Linux and Raspberry Pi OS. Install with:
#
#   sudo install -m 755 gdash /usr/local/bin/gdash
#   sudo install -m 644 gdash.service /etc/systemd/system/gdash.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now gdash
#   journalctl -u gdash    # shows the setup token on the first start
#
# GDash runs as a throwaway user with only its data directory writable.

[Unit]
Description=GDash TV dashboard
Documentation=https://github.com/stijnvandepol/gdash
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/gdash
Environment=GDASH_DATA_DIR=/var/lib/gdash
# Uncomment to listen on another port; open it in the firewall for your TVs.
#Environment=GDASH_ADDR=:8420
Restart=on-failure
RestartSec=5

# Sandbox. Check the result with: systemd-analyze security gdash
# A throwaway user; the data directory is the only place it can write, and
# only that user can read it. A port below 1024 needs
# AmbientCapabilities=CAP_NET_BIND_SERVICE here; the default 8420 does not.
# Left out on purpose: PrivateNetwork and IPAddressAllow, because GDash must
# reach the LAN, the internet and multicast, and PrivateUsers, which
# DynamicUser makes pointless.
DynamicUser=yes
StateDirectory=gdash
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RemoveIPC=yes
# Hide other processes and the kernel interfaces GDash never reads. Go falls
# back to a default when /proc/sys is hidden.
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# A blocked call fails with EPERM instead of killing GDash.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Netlink lists the network interfaces for Cast discovery (mDNS).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
