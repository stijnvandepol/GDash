# systemd unit for Nookboard on Linux and Raspberry Pi OS. Install with:
#
#   sudo install -m 755 nookboard /usr/local/bin/nookboard
#   sudo install -m 644 nookboard.service /etc/systemd/system/nookboard.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now nookboard
#   journalctl -u nookboard    # shows the setup token on the first start
#
# Nookboard runs as a throwaway user with only its data directory writable.

[Unit]
Description=Nookboard TV dashboard
Documentation=https://github.com/stijnvandepol/nookboard
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/nookboard
Environment=NOOKBOARD_DATA_DIR=/var/lib/nookboard
# Uncomment to listen on another port; open it in the firewall for your TVs.
#Environment=NOOKBOARD_ADDR=:8420
Restart=on-failure
RestartSec=5

DynamicUser=yes
StateDirectory=nookboard
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# Netlink lists the network interfaces for Cast discovery (mDNS).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
